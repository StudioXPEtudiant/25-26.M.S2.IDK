code = "shader_type canvas_item;
render_mode blend_mix;

uniform vec4 ColorParameter : source_color = vec4(0.867575, 1.000000, 0.779998, 1.000000);



void fragment() {
	vec3 n_out6p0;
// ColorFunc:6
	vec3 n_in6p0 = vec3(0.35000, 0.00000, 0.00000);
	{
		vec3 c = n_in6p0;
		float max1 = max(c.r, c.g);
		float max2 = max(max1, c.b);
		n_out6p0 = vec3(max2, max2, max2);
	}


// Input:3
	vec4 n_out3p0 = COLOR;


// VectorOp:5
	vec4 n_out5p0 = vec4(n_out6p0, 0.0) + n_out3p0;


// ColorParameter:10
	vec4 n_out10p0 = ColorParameter;


// Input:8
	vec4 n_out8p0 = COLOR;


// VectorOp:9
	vec4 n_out9p0 = n_out10p0 * n_out8p0;


// VectorOp:11
	vec4 n_out11p0 = n_out5p0 * n_out9p0;


// Output:0
	COLOR.rgb = vec3(n_out11p0.xyz);


}
"
